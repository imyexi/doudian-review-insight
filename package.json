{
  "name": "doudian-review-insight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --bundle --format=esm --packages=external --outdir=dist/server",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run --root .",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "tsx server/db/migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@tanstack/react-query": "^5.90.2",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "express": "^4.21.2",
    "iconv-lite": "0.4.24",
    "lucide-react": "^0.542.0",
    "multer": "^2.0.2",
    "openai": "^6.34.0",
    "pino": "^9.9.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.7.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.25.11",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^2.1.9"
  }
}
